    <DTS:Executable
      DTS:refId="Package\Create Clean Dim Category"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{60f4a7a7-5262-4a09-889c-50f08300c029}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Clean Dim Category"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{98B0CBCE-410E-4906-B753-6181D532F9AC}"
          SQLTask:SqlStatementSource="/* =========================================================================&#xA;   CREATE clean_dim_category Table using the IF NOT EXISTS clause (SAFE RERUN)&#xA;   Database : stg_brightlearn_sales&#xA;   Schema   : dbo&#xA;   ========================================================================= */&#xA;&#xA;IF OBJECT_ID('[stg_brightlearn_sales].[dbo].[clean_dim_category]', 'U') IS NULL&#xA;BEGIN&#xA;&#xA;    CREATE TABLE [stg_brightlearn_sales].[dbo].[clean_dim_category] (&#xA;    &#xA;        [category] [nvarchar](50) NOT NULL,&#xA;        [created_date] DATETIME2(0) NOT NULL DEFAULT GETDATE(),&#xA;        [modified_date] DATETIME2(0) NOT NULL DEFAULT GETDATE()&#xA;    );&#xA;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Clean Dim Category"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7f54cc56-d93f-42d6-95bc-43da3b111040}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Clean Dim Category"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{98B0CBCE-410E-4906-B753-6181D532F9AC}"
          SQLTask:SqlStatementSource="/* ===================================================================&#xA;   INSERT INTO clean_dim_category (SAFE RERUN)&#xA;   1.Used the SELECT DISTINCT Clause to return only unique values&#xA;   2.COALESCE to replace NULL value with &quot;Unknown&quot;&#xA;   3.Then used the WHERE NOT EXISTS clause to avoid data duplication&#xA;   =================================================================== */&#xA;&#xA;WITH cleaned_category AS (&#xA;&#xA;    SELECT DISTINCT &#xA;            COALESCE(TRIM(UPPER(category)),'UNKNOWN') AS category  &#xA;&#xA;        FROM [stg_brightlearn_sales].[dbo].[stg_dim_category] &#xA;)&#xA;&#xA;&#xA;INSERT INTO [stg_brightlearn_sales].[dbo].[clean_dim_category]&#xA;(&#xA;        [category]&#xA;)&#xA;&#xA;&#xA;--From the CTE query&#xA;SELECT * FROM cleaned_category&#xA;&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM [stg_brightlearn_sales].[dbo].[clean_dim_category] c&#xA;    WHERE c.[category] = [category]&#xA;   &#xA;);&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
