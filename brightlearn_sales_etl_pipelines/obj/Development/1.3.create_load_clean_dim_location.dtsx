    <DTS:Executable
      DTS:refId="Package\Create Clean Dim Location"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{bcac3619-0704-47d1-9ffc-3206fa3e584d}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Clean Dim Location"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D832732C-6119-4DB0-A54C-AE811FE231BA}"
          SQLTask:SqlStatementSource="/* =========================================================================&#xA;   CREATE clean_dim_location Table using the IF NOT EXISTS clause (SAFE RERUN)&#xA;   Database : stg_brightlearn_sales&#xA;   Schema   : dbo&#xA;   ========================================================================= */&#xA;&#xA;IF OBJECT_ID('[stg_brightlearn_sales].[dbo].[clean_dim_location]', 'U') IS NULL&#xA;BEGIN&#xA;&#xA;    CREATE TABLE [stg_brightlearn_sales].[dbo].[clean_dim_location] (&#xA;&#xA;        [customer_city] VARCHAR (100),&#xA;        [customer_province] VARCHAR (100),&#xA;        [created_date] DATETIME2(0) NOT NULL DEFAULT GETDATE(),&#xA;        [modified_date] DATETIME2(0) NOT NULL DEFAULT GETDATE()&#xA;    );&#xA;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Clean Dim Location"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7b0f87a8-3eeb-4ee6-a653-e7a864d45c8c}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Clean Dim Location"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D832732C-6119-4DB0-A54C-AE811FE231BA}"
          SQLTask:SqlStatementSource="/* ===================================================================&#xA;   INSERT INTO clean_dim_location (SAFE RERUN)&#xA;   1.Used the SELECT DISTINCT Clause to return only unique values&#xA;   2.Used the COALESCE function to replace the NULLs with the &quot;Unknown&quot;&#xA;   3.Then used the WHERE NOT EXISTS clause to avoid data duplication&#xA;   =================================================================== */&#xA;&#xA;WITH cleaned_location AS (&#xA;&#xA;    &#xA;    SELECT DISTINCT&#xA;           COALESCE(TRIM(UPPER(customer_city)),'UNKNOWN') AS customer_city,&#xA;&#xA;           COALESCE(TRIM(UPPER(customer_province)),'UNKNOWN') AS customer_province&#xA;&#xA;    FROM [stg_brightlearn_sales].[dbo].[stg_dim_location] &#xA;)&#xA;&#xA;&#xA;INSERT INTO [stg_brightlearn_sales].[dbo].[clean_dim_location]&#xA;(&#xA;     [customer_city]&#xA;    ,[customer_province]&#xA;)&#xA;&#xA;-- From the CTE query&#xA;SELECT * FROM cleaned_location c&#xA;&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM [stg_brightlearn_sales].[dbo].[clean_dim_location] l&#xA;    WHERE l.[customer_city] = [customer_city]&#xA;      AND l.[customer_province] = [customer_province] &#xA;      &#xA;);&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
