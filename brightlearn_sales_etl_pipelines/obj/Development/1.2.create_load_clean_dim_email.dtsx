      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2da5ed35-ce39-43cb-9fde-cb462a357b62}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Clean Dim Email"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{686B0491-4F4F-425B-89E0-75EA8494C125}"
          SQLTask:SqlStatementSource="/* =========================================================================&#xA;   CREATE clean_dim_email Table using the IF NOT EXISTS clause (SAFE RERUN)&#xA;   Database : stg_brightlearn_sales&#xA;   Schema   : dbo&#xA;   ========================================================================= */&#xA;&#xA;IF OBJECT_ID('[stg_brightlearn_sales].[dbo].[clean_dim_email]', 'U') IS NULL&#xA;BEGIN&#xA;&#xA;    CREATE TABLE [stg_brightlearn_sales].[dbo].[clean_dim_email] (&#xA;&#xA;        [customer_email] [nvarchar](50) NOT NULL,&#xA;        [created_date] DATETIME2(0) NOT NULL DEFAULT GETDATE(),&#xA;        [modified_date] DATETIME2(0) NOT NULL DEFAULT GETDATE()&#xA;    );&#xA;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Clean Dim Email"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7ea1ee8d-2dd7-43dc-987c-4ea0723c7a0f}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Clean Dim Email"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{686B0491-4F4F-425B-89E0-75EA8494C125}"
          SQLTask:SqlStatementSource="/* ===================================================================&#xA;   INSERT INTO clean_dim_email (SAFE RERUN)&#xA;   1.Used the SELECT DISTINCT Clause to return only unique values&#xA;   2.Used the WHERE NOT EXISTS clause to avoid data duplication&#xA;   3.TRIM fucntion to remove unwanted spaces&#xA;   =================================================================== */&#xA;&#xA;&#xA;WITH cleaned_email AS (&#xA;&#xA;&#xA;    SELECT DISTINCT&#xA;            COALESCE(TRIM(customer_email),'UNKNOWN') AS customer_email &#xA;&#xA;    FROM [stg_brightlearn_sales].[dbo].[stg_dim_email]&#xA;)&#xA;&#xA;INSERT INTO [stg_brightlearn_sales].[dbo].[clean_dim_email]&#xA;(&#xA;        [customer_email]&#xA;)&#xA;&#xA;-- From the CTE query&#xA;SELECT * FROM cleaned_email&#xA;       &#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM [stg_brightlearn_sales].[dbo].[clean_dim_email] c&#xA;    WHERE c.[customer_email] = customer_email&#xA;      &#xA;);&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
