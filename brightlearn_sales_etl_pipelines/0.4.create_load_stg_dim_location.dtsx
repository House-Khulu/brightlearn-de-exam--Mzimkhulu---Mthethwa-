      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D0E017C8-6B0E-4552-9FD6-9CFCA9C332F2}"
          SQLTask:SqlStatementSource="/* =========================================================================&#xA;   CREATE stg_dim_location Table using the IF NOT EXISTS clause (SAFE RERUN)&#xA;   Database : stg_brightlearn_sales&#xA;   Schema   : dbo&#xA;   ========================================================================= */&#xA;&#xA;IF OBJECT_ID('[stg_brightlearn_sales].[dbo].[stg_dim_location]', 'U') IS NULL&#xA;BEGIN&#xA;&#xA;    CREATE TABLE [stg_brightlearn_sales].[dbo].[stg_dim_location] (&#xA;&#xA;        [customer_city] VARCHAR (100),&#xA;        [customer_province] VARCHAR (100),&#xA;        [created_date] DATETIME2(0) NOT NULL DEFAULT GETDATE(),&#xA;        [modified_date] DATETIME2(0) NOT NULL DEFAULT GETDATE()&#xA;    );&#xA;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Staging Dim Location"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{973135f3-910a-4c28-b2fd-a4fb6ef02b76}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Staging Dim Location"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D0E017C8-6B0E-4552-9FD6-9CFCA9C332F2}"
          SQLTask:SqlStatementSource="/* ===================================================================&#xA;   INSERT INTO stg_dim_location (SAFE RERUN)&#xA;   1.Used the SELECT DISTINCT Clause to return only unique values&#xA;   2.Used the COALESCE function to replace the NULLs with the &quot;Unknown&quot;&#xA;   3.Then used the WHERE NOT EXISTS clause to avoid data duplication&#xA;   =================================================================== */&#xA;&#xA;INSERT INTO [stg_brightlearn_sales].[dbo].[stg_dim_location]&#xA;(&#xA;     [customer_city]&#xA;    ,[customer_province]&#xA;)&#xA;&#xA;&#xA;SELECT DISTINCT&#xA;      r.[customer_city],&#xA;      r.[customer_province]&#xA;FROM [stg_brightlearn_sales].[dbo].[brightlearn_raw_data] r&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM [stg_brightlearn_sales].[dbo].[stg_dim_location] l&#xA;    WHERE l.[customer_city] = r.[customer_city]&#xA;      AND l.[customer_province] = r.[customer_province]&#xA;      &#xA;);&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
