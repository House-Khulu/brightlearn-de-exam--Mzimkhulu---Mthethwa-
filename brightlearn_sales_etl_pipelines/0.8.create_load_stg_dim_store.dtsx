      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8FB85FEA-35D2-4D5F-8153-E6497FB2CE44}"
          SQLTask:SqlStatementSource="/* =========================================================================&#xA;   CREATE stg_dim_store Table using the IF NOT EXISTS clause (SAFE RERUN)&#xA;   Database : stg_brightlearn_sales&#xA;   Schema   : dbo&#xA;   ========================================================================= */&#xA;&#xA;IF OBJECT_ID('[stg_brightlearn_sales].[dbo].[stg_dim_store]', 'U') IS NULL&#xA;BEGIN&#xA;&#xA;    CREATE TABLE [stg_brightlearn_sales].[dbo].[stg_dim_store] (&#xA;&#xA;        [store_name] VARCHAR (100) NOT NULL,&#xA;        [store_city] VARCHAR (100) NOT NULL,&#xA;        [store_province] VARCHAR (100) NOT NULL,&#xA;        [store_region] VARCHAR (100) NOT NULL,&#xA;        [store_manager] VARCHAR (100) NOT NULL,&#xA;        [created_date] DATETIME2(0) NOT NULL DEFAULT GETDATE(),&#xA;        [modified_date] DATETIME2(0) NOT NULL DEFAULT GETDATE()&#xA;    );&#xA;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Staging Dim Store"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{c59bb723-b29e-48ad-a2c0-d126b9bf7583}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Staging Dim Store"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8FB85FEA-35D2-4D5F-8153-E6497FB2CE44}"
          SQLTask:SqlStatementSource="/* ===================================================================&#xA;   INSERT INTO stg_dim_store (SAFE RERUN)&#xA;   1.Used the SELECT DISTINCT Clause to return only unique values&#xA;   2.Then used the WHERE NOT EXISTS clause to avoid data duplication&#xA;   =================================================================== */&#xA;&#xA;INSERT INTO [stg_brightlearn_sales].[dbo].[stg_dim_store]&#xA;(&#xA;&#xA;           [store_name]&#xA;          ,[store_city]&#xA;          ,[store_province]&#xA;          ,[store_region]&#xA;          ,[store_manager]&#xA;)&#xA;&#xA;&#xA;SELECT DISTINCT&#xA;           r.[store_name],&#xA;           r.[store_city],&#xA;           r.[store_province],&#xA;           r.[store_region],&#xA;           r.[store_manager]&#xA;&#xA;FROM [stg_brightlearn_sales].[dbo].[brightlearn_raw_data] r&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM [stg_brightlearn_sales].[dbo].[stg_dim_store] s&#xA;    WHERE &#xA;          s.[store_name] = r.[store_name]&#xA;      AND s.[store_city] = r.[store_city]&#xA;      AND s.[store_province] = r.[store_province]&#xA;      AND s.[store_region] = r.[store_region]&#xA;      AND s.[store_manager] = r.[store_manager]&#xA;      &#xA;);&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Truncate Staging Dim Store"
